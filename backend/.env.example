# Groq API settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-to-a-random-secret

# Default user passwords (REQUIRED - app will refuse to start without these)
ADMIN_PASSWORD=change-this-admin-password
USER_PASSWORD=change-this-user-password

# Backend Server Configuration
BACKEND_URL=http://localhost:5000

# CORS: comma-separated origins allowed to access the API
# In production, set this to your actual domain (e.g., https://yourdomain.com)
# For multiple origins: https://app1.com,https://app2.com
CORS_ORIGINS=http://localhost:5000
